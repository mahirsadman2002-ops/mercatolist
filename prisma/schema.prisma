generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  USER
  BROKER
  ADMIN
}

enum ListingStatus {
  DRAFT
  ACTIVE
  UNDER_CONTRACT
  SOLD
  OFF_MARKET
}

enum OwnerInvolvement {
  OWNER_OPERATED
  ABSENTEE
}

enum Borough {
  MANHATTAN
  BROOKLYN
  QUEENS
  BRONX
  STATEN_ISLAND
}

enum InquiryType {
  ANONYMOUS_FORM
  MESSAGE_THREAD
}

enum ReportType {
  LISTING
  REVIEW
  DEAL
  USER
}

enum ReportReason {
  INACCURATE
  SUSPICIOUS
  DUPLICATE
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum CheckFrequency {
  DAILY
  WEEKLY
}

enum EmailFrequency {
  IMMEDIATELY
  DAILY_DIGEST
  WEEKLY_DIGEST
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum ReviewExperienceType {
  BOUGHT
  SOLD
  COLLABORATED
}

enum TransactionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  name           String
  displayName    String?
  bio            String?   @db.Text
  avatarUrl      String?
  phone          String?
  website        String?
  role           UserRole  @default(USER)
  ownedBusiness  String?
  buyBox         Json?

  // Advisor/Broker-specific
  brokerageName       String?
  brokerageWebsite    String?
  brokeragePhone      String?
  boroughsServed      String[]
  specialties         String[]
  yearsOfExperience   Int?
  hasLicenses         Boolean  @default(false)
  profileCompleteness Int      @default(0)
  instagramUrl        String?
  linkedinUrl         String?
  twitterUrl          String?
  facebookUrl         String?
  tiktokUrl           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts                   Account[]
  sessions                   Session[]
  listings                   BusinessListing[]
  coListings                 BusinessListing[]         @relation("CoBrokers")
  receivedInquiries          Inquiry[]                 @relation("ReceivedInquiries")
  sentInquiries              Inquiry[]                 @relation("SentInquiries")
  savedListings              SavedListing[]
  collections                Collection[]
  receivedReviews            Review[]                  @relation("ReceivedReviews")
  givenReviews               Review[]                  @relation("GivenReviews")
  transactionReviewsApproved Review[]                  @relation("TransactionReviewer")
  savedSearches              SavedSearch[]
  messages                   Message[]
  reports                    Report[]
  statusLogs                 ListingStatusLog[]
  emailVerificationTokens    EmailVerificationToken[]
  reviewTokens               ReviewToken[]             @relation("ReviewTokens")
  blogPosts                  BlogPost[]
  searchLogs                 SearchLog[]
  licenses                   License[]
  pastDeals                  PastDeal[]
  collectionCollaborations   CollectionCollaborator[]
  collectionNotes            CollectionNote[]
  collectionAccessRequests   CollectionAccessRequest[] @relation("CollectionAccessRequests")
  clients                    Client[]                  @relation("advisorClients")

  // Admin: ban management
  isBanned     Boolean @default(false)
  bannedReason String?

  // Managed accounts: created by an admin on a seller's behalf. "Unclaimed"
  // until the person sets a password via the claim link. Reminders run until
  // claimedAt is set; lastClaimReminderAt throttles them to once/day.
  isManaged           Boolean   @default(false)
  claimedAt           DateTime?
  lastClaimReminderAt DateTime?

  @@index([role])
  @@index([email])
}

model BusinessListing {
  id             String        @id @default(uuid())
  // Short human-friendly sequential ID (e.g. "ML-1042") that buyers can search by.
  listingNumber  Int           @unique @default(autoincrement())
  slug           String        @unique
  status         ListingStatus @default(ACTIVE)
  isGhostListing Boolean       @default(false)
  shareToken     String?       @unique

  // Basic Info
  title       String
  description String @db.Text
  category    String

  // Financials
  askingPrice           Decimal  @db.Decimal(12, 2)
  annualRevenue         Decimal? @db.Decimal(12, 2)
  cashFlowSDE           Decimal? @db.Decimal(12, 2)
  netIncome             Decimal? @db.Decimal(12, 2)
  profitMargin          Decimal? @db.Decimal(5, 2)
  askingMultiple        Decimal? @db.Decimal(5, 2)
  monthlyRent           Decimal? @db.Decimal(10, 2)
  rentEscalation        String?
  annualPayroll         Decimal? @db.Decimal(12, 2)
  totalExpenses         Decimal? @db.Decimal(12, 2)
  inventoryValue        Decimal? @db.Decimal(10, 2)
  inventoryIncluded     Boolean?
  ffeValue              Decimal? @db.Decimal(10, 2)
  ffeIncluded           Boolean?
  sellerFinancing       Boolean  @default(false)
  sbaFinancingAvailable Boolean  @default(false)
  // Asset sale: business sold for its assets (equipment, fixtures, lease, etc.)
  // rather than as a going concern — revenue/profit figures are optional.
  assetSale             Boolean  @default(false)

  // Business Details
  yearEstablished        Int?
  numberOfEmployees      Int?
  employeesWillingToStay Boolean?
  ownerInvolvement       OwnerInvolvement?
  ownerHoursPerWeek      Int?
  squareFootage          Int?
  leaseTerms             String?
  leaseRenewalOption     Boolean?
  reasonForSelling       String?
  licensesPermits        String?
  trainingSupport        String?

  // Location
  address      String
  hideAddress  Boolean @default(false)
  neighborhood String
  borough      Borough
  city         String  @default("New York")
  state        String  @default("NY")
  zipCode      String
  latitude     Decimal @db.Decimal(10, 7)
  longitude    Decimal @db.Decimal(10, 7)

  // Privacy & Display
  showPhoneNumber Boolean @default(true)

  // Metrics
  viewCount  Int @default(0)
  saveCount  Int @default(0)
  shareCount Int @default(0)

  // Listing Management
  lastStatusConfirmation    DateTime?
  statusConfirmationDue     DateTime?
  // Non-response tracking: how many confirmation reminders have been sent
  // since the owner last confirmed (reset to 0 on confirmation).
  confirmationRemindersSent Int       @default(0)
  lastReminderSentAt        DateTime?

  // Admin fields
  isFeatured Boolean @default(false)
  adminNotes String? @db.Text

  // Sold listing data
  soldPrice Decimal?  @db.Decimal(12, 2)
  soldDate  DateTime?

  // Relations
  listedBy   User   @relation(fields: [listedById], references: [id])
  listedById String
  coBrokers  User[] @relation("CoBrokers")

  photos    Photo[]
  inquiries Inquiry[]

  savedByUsers       SavedListing[]
  collectionListings CollectionListing[]
  collectionNotes    CollectionNote[]
  statusLogs         ListingStatusLog[]
  linkedFromReviews  Review[]            @relation("LinkedTransactionListing")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([borough])
  @@index([neighborhood])
  @@index([askingPrice])
  @@index([createdAt])
  @@index([listedById])
  @@index([slug])
  @@index([status, category, borough])
}

model Photo {
  id        String @id @default(uuid())
  url       String
  order     Int
  listingId String

  listing BusinessListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Inquiry {
  id   String      @id @default(uuid())
  type InquiryType

  // For anonymous inquiries
  senderName  String?
  senderEmail String?
  senderPhone String?
  message     String  @db.Text

  // Relations
  listingId  String
  listing    BusinessListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?           @relation("SentInquiries", fields: [senderId], references: [id])
  receiverId String
  receiver   User            @relation("ReceivedInquiries", fields: [receiverId], references: [id])
  isRead     Boolean         @default(false)

  // Thread messages
  messages Message[]

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
}

model Message {
  id        String  @id @default(uuid())
  content   String  @db.Text
  inquiryId String
  senderId  String
  isRead    Boolean @default(false)

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@index([senderId])
}

model SavedListing {
  id        String @id @default(uuid())
  userId    String
  listingId String

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing BusinessListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Collection {
  id               String  @id @default(uuid())
  name             String
  description      String?
  userId           String
  shareToken       String? @unique
  isPubliclyShared Boolean @default(false)
  /// Legacy single-client assignment; new code uses the CollectionClient join.
  /// Kept nullable for backwards compatibility, populated by migration into the join.
  clientId         String?

  /// When the owner last opened this collection — used to compute unread notes for them.
  ownerLastNotesReadAt DateTime?

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client             Client?                   @relation(fields: [clientId], references: [id])
  collectionListings CollectionListing[]
  collaborators      CollectionCollaborator[]
  notes              CollectionNote[]
  clientAssignments  CollectionClient[]
  accessRequests     CollectionAccessRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

model CollectionClient {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())
  addedById    String

  @@unique([collectionId, clientId])
  @@index([collectionId])
  @@index([clientId])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
}

model CollectionAccessRequest {
  id              String              @id @default(uuid())
  collectionId    String
  collection      Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId          String
  user            User                @relation("CollectionAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  status          AccessRequestStatus @default(PENDING)
  requestedAt     DateTime            @default(now())
  lastRequestedAt DateTime            @default(now())
  decidedAt       DateTime?
  decidedById     String?

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
  @@index([status])
}

model SavedSearch {
  id     String  @id @default(uuid())
  userId String
  name   String?

  // Search criteria
  criteria Json

  // Notification settings
  checkFrequency CheckFrequency @default(DAILY)
  emailFrequency EmailFrequency @default(DAILY_DIGEST)
  isActive       Boolean        @default(true)

  lastCheckedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

model Review {
  id           String  @id @default(uuid())
  rating       Int
  text         String? @db.Text
  reviewerId   String
  brokerId     String
  isReported   Boolean @default(false)
  reportReason String?

  // Experience metadata
  experienceType   ReviewExperienceType?
  businessCategory String?
  businessName     String?
  businessAddress  String?
  transactionPrice Decimal?              @db.Decimal(12, 2)
  transactionYear  Int?

  // Broker response
  response   String?   @db.Text
  responseAt DateTime?

  // Admin verification → sold listing creation
  transactionStatus       TransactionReviewStatus?
  transactionReviewedById String?
  transactionReviewedAt   DateTime?
  linkedListingId         String?

  reviewer            User             @relation("GivenReviews", fields: [reviewerId], references: [id])
  broker              User             @relation("ReceivedReviews", fields: [brokerId], references: [id])
  transactionReviewer User?            @relation("TransactionReviewer", fields: [transactionReviewedById], references: [id])
  linkedListing       BusinessListing? @relation("LinkedTransactionListing", fields: [linkedListingId], references: [id])

  createdAt DateTime @default(now())

  @@index([brokerId])
  @@index([reviewerId])
  @@index([transactionStatus])
}

model ReviewToken {
  id          String   @id @default(uuid())
  token       String   @unique
  brokerId    String
  broker      User     @relation("ReviewTokens", fields: [brokerId], references: [id], onDelete: Cascade)
  clientEmail String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([brokerId])
  @@index([token])
}

model Report {
  id      String       @id @default(uuid())
  type    ReportType
  reason  ReportReason
  details String?      @db.Text

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  // Polymorphic target
  listingId String?
  reviewId  String?
  userId    String?

  status     ReportStatus @default(PENDING)
  adminNotes String?      @db.Text

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([reporterId])
  @@index([type])
}

model ListingStatusLog {
  id              String @id @default(uuid())
  listingId       String
  confirmedById   String
  previousStatus  String
  confirmedStatus String

  listing     BusinessListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  confirmedBy User            @relation(fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())

  @@index([listingId])
}

model BlogPost {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  content         String         @db.Text
  excerpt         String?
  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  category        String?
  tags            String[]
  status          BlogPostStatus @default(DRAFT)
  authorId        String
  publishedAt     DateTime?
  viewCount       Int            @default(0)

  author User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([slug])
  @@index([authorId])
}

model SearchLog {
  id          String  @id @default(uuid())
  query       String
  filters     Json?
  resultCount Int     @default(0)
  userId      String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model License {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  issuingAuthority String?
  licenseNumber    String?
  expirationDate   DateTime?
  documentUrl      String?
  isVerified       Boolean   @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model PastDeal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  category     String?
  borough      String?
  neighborhood String?
  salePrice    Decimal?
  dateSold     DateTime?
  notes        String?   @db.Text
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// ─── Collection & Client Models ─────────────────────────────────────

model CollectionListing {
  id               String          @id @default(uuid())
  collectionId     String
  collection       Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listingId        String
  listing          BusinessListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  personalRating   Int?
  ratedBy          String?
  clientInterested Boolean?
  addedBy          String
  addedAt          DateTime        @default(now())

  @@unique([collectionId, listingId])
  @@index([collectionId])
  @@index([listingId])
}

model CollectionCollaborator {
  id              String     @id @default(uuid())
  collectionId    String
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "viewer" or "editor"
  role            String     @default("viewer")
  invitedBy       String
  invitedAt       DateTime   @default(now())
  acceptedAt      DateTime?
  /// When this collaborator last opened the collection — used to compute their unread-note count.
  lastNotesReadAt DateTime?

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
}

model CollectionNote {
  id           String           @id @default(uuid())
  collectionId String
  collection   Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      BusinessListing? @relation(fields: [listingId], references: [id])
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  content      String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([collectionId])
  @@index([listingId])
  @@index([userId])
}

model Client {
  id                    String             @id @default(uuid())
  advisorId             String
  advisor               User               @relation("advisorClients", fields: [advisorId], references: [id], onDelete: Cascade)
  name                  String
  email                 String
  phone                 String?
  company               String?
  preferredCategories   String[]
  preferredBoroughs     String[]
  priceRangeMin         Decimal?
  priceRangeMax         Decimal?
  revenueRangeMin       Decimal?
  revenueRangeMax       Decimal?
  notes                 String?            @db.Text
  /// Set when the broker sent this client an invite to join MercatoList.
  invitedToPlatformAt   DateTime?
  collections           Collection[]
  collectionAssignments CollectionClient[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([advisorId, email])
  @@index([advisorId])
}

// ─── Product Feedback / Bug Reports ──────────────────────────────────

enum FeedbackType {
  BUG
  IDEA
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

// User-submitted bug reports and product ideas (the floating "Feedback"
// widget). Distinct from Report, which is for flagging listings/users.
// userId is a plain scalar (no FK) so feedback survives user deletion.
model Feedback {
  id         String         @id @default(uuid())
  type       FeedbackType   @default(BUG)
  message    String         @db.Text
  email      String?
  pageUrl    String?
  userAgent  String?        @db.Text
  userId     String?
  status     FeedbackStatus @default(NEW)
  adminNotes String?        @db.Text
  createdAt  DateTime       @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([createdAt])
}
